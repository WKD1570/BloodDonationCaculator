                <IncludedArea>채널 제도</IncludedArea>
                <IncludedArea>포클랜드 섬</IncludedArea>
            </Region>
            <Region country="프랑스·아일랜드" targetPeriod="1980년~2001년까지" minStay="5년 이상">
                <IncludedArea>전지역 (별도 기재 없음)</IncludedArea>
            </Region>
        </Rule>
    </vCJD_Regions>

