        <Rule deferralType="영구배제">
            <Region country="영국" targetPeriod="1980년~1996년" minStay="3개월 이상">
                <IncludedArea>맨 섬</IncludedArea>
                <IncludedArea>북아일랜드</IncludedArea>
                <IncludedArea>스코틀랜드</IncludedArea>
