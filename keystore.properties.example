# Copy this to keystore.properties (gitignored) and fill it in to sign release builds with your
# Play upload key. Keep the keystore outside the repo; storeFile is absolute or relative to the
# project root. Never use 무제.jks: it was committed once and is still public in PR #1's history.
storeFile=/Users/<you>/keystores/bdcalculator-upload.jks
storePassword=
keyAlias=upload
keyPassword=
